o.org":{"title":"ITCILO Alumni Network","description":"The ITCILO Alumni Network connects former participants of ITCILO programmes, fostering a global community of professionals dedicated to sustainable development and promoting social justice through decent work. This platform offers ITCILO alumni focused networking opportunities, and professional development possibilities. The platform supports ongoing collaboration, and career advancement, reinforcing the commitment to lifelong learning and the mission of promoting social justice and decent work worldwide.","identity":"ITCILO Alumni Network","spiderable":"all","image":"/assets/themes/alumni.itcilo.org/images/seo_image.png","twitterSite":"https://x.com/ITCILO","twitterCreator":"@ITCILO","app":"spotlight","languages":["en"],"recipientPortalUrls":[],"spotlightUrl":"alumni.itcilo.org"},"accredible.credential.net":{"title":"Accredible","description":"Accredible","identity":"Accredible","spiderable":"all","image":"/assets/themes/accredible.credential.net/images/seo_image.png","twitterSite":"@accredible","twitterCreator":"@accredible","app":"recipient-portal","languages":["en"],"recipientPortalUrls":["accredible.credential.net"],"spotlightUrl":null},"certification.wallstreetprep.com":{"title":"Wallstreetprep","description":"Wallstreetprep Recipient Portal","identity":"Wallstreetprep","spiderable":"noindex, nofollow","image":"/assets/themes/certification.wallstreetprep.com/images/seo_image.png","twitterSite":"@accredible","twitterCreator":"@accredible","app":"recipient-portal","languages":["en"],"recipientPortalUrls":["certification.wallstreetprep.com"],"spotlightUrl":null},"certificates.toptiertrader.com":{"title":"TopTier Trading","description":"TopTier Trading","identity":"TopTier Trading","spiderable":"noindex, nofollow","image":"","twitterSite":"@accredible","twitterCreator":"@accredible","app":"recipient-portal","languages":["en"],"recipientPortalUrls":["certificates.toptiertrader.com"],"spotlightUrl":null},"badges